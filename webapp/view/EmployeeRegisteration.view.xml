<mvc:View controllerName="com.employee.employeeregistration.controller.EmployeeRegisteration"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Page id="page" title="{i18n>EmployeeRegistration}" titleAlignment="Center" class="myPageBg">
        <content>
        <Image
                src="images/Media (5).jpg"
                width="100%"
                height="150px"
                densityAware="false"
                class="sapUiSmallMarginBottom" />
        <!-- Registartion Form -->
        <VBox class="sapUiSmallMargin myCard" width="100%" >

        <!-- Personal Details -->
        <VBox width="34%" class="sapUiSmallMargin">
        <items>
          <HBox alignItems="Center" class="sapUiSmallMarginBottom">
            <core:Icon
                src="sap-icon://person-placeholder"
                size="1.25rem"
                color="#0070f2"
                class="sapUiTinyMarginEnd" />
            <Title text="{i18n>PersonalDetails}" ></Title>
            </HBox>
            
             <HBox >
                <Label text="{i18n>Name}" required="true" showColon="true" width="70px"></Label>
                <Input placeholder="Enter Your Name" width="340px" id="nameInput"></Input>
            </HBox>

            <!-- Email -->
            <HBox >
                <Label text="{i18n>Email}" required="true" showColon="true" width="70px"></Label>
                <Input placeholder="Enter Your Email" width="340px" id="emailInput"></Input>
            </HBox>

            <!-- Phone -->
            <HBox >
                <Label text="{i18n>Phone}" required="true" showColon="true" width="70px"></Label>
                <Input placeholder="Enter Your Phone Number" width="340px" id="phoneInput"></Input>
            </HBox>

        </items>
        </VBox>

        <!-- Address Details -->
        <VBox  class="sapUiSmallMargin" >
        <items>
       <HBox>
        <core:Icon
                src="sap-icon://map"
                size="1.25rem"
                color="#0070f2"
                class="sapUiTinyMarginEnd" />
         <Title text="{i18n>AddressDetails}" level="H1"></Title>
       </HBox>
      
            <!-- Name -->
            <HBox >
                <Label text="{i18n>Street}" required="true" showColon="true" width="70px"></Label>
                <Input placeholder="Enter Street" width="340px" id="streetInput"></Input>
            </HBox>

            <!-- Email -->
            <HBox >
                <Label text="{i18n>City}" required="true" showColon="true" width="70px"></Label>
                <Input placeholder="Enter City" width="340px" id="cityInput"></Input>
            </HBox>

            <!-- Phone -->
            <HBox >
                <Label text="{i18n>Pincode}" required="true" showColon="true" width="70px"></Label>
                <Input placeholder="Enter Pincode" width="340px" id="pincodeInput"></Input>
            </HBox>
            <Image
                        src="images/profile.png"
                        width="120px"
                        height="120px"
                        densityAware="false"
                        class="sapUiSmallMarginTop myRoundImage" />
        </items>
        </VBox>


        </VBox>
        </content>
        <footer>
            <Bar>
                <contentRight>
                    <Button text="{i18n>PreviewProfile}" type="Emphasized" icon="sap-icon://show" press="onPreview" >
                    </Button>
                    </contentRight>
            </Bar>
        </footer>
    </Page>
</mvc:View>