<mvc:View
    controllerName="com.employee.employeeregistration.controller.EmployeeProfileSummary"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Page
        id="page1"
        title="{i18n>EmployeeProfileSummary}"
        titleAlignment="Center"
        showNavButton="true"
        navButtonPress="onBACKButtonPress"
    >
        <content>
            <!-- Registartion Form -->
            <VBox
                class="sapUiSmallMargin"
                width="100%"
            >
                <!-- Personal Details -->
                <VBox
                    width="34%"
                    class="sapUiSmallMargin"
                >
                    <items>
                        <HBox
                            alignItems="Center"
                            class="sapUiSmallMarginBottom"
                        >
                            <core:Icon
                                src="sap-icon://person-placeholder"
                                size="1.25rem"
                                color="#0070f2"
                                class="sapUiTinyMarginEnd"
                            />
                            <Title text="{i18n>PersonalDetails}" />
                        </HBox>
                        <HBox>
                            <Label
                                text="{i18n>Name}"
                                showColon="true"
                                width="70px"
                            />
                            <Text
                                width="340px"
                                id="nameText"
                                text="{oPersonalDeatilsModel>/name}"
                            />
                        </HBox>
                        <!-- Email -->
                        <HBox>
                            <Label
                                text="{i18n>Email}"
                                showColon="true"
                                width="70px"
                            />
                            <Text
                                width="340px"
                                id="emailText"
                                text="{oPersonalDeatilsModel>/email}"
                            />
                        </HBox>
                        <!-- Phone -->
                        <HBox>
                            <Label
                                text="{i18n>Phone}"
                                showColon="true"
                                width="70px"
                            />
                            <Text
                                width="340px"
                                id="phoneText"
                                text="{oPersonalDeatilsModel>/phone}"
                            />
                        </HBox>
                    </items>
                </VBox>
                <!-- Address Details -->
                <VBox>
                    <items>
                        <HBox>
                            <core:Icon
                                src="sap-icon://map"
                                size="1.25rem"
                                color="#0070f2"
                                class="sapUiTinyMarginEnd"
                            />
                            <Title
                                text="{i18n>AddressDetails}"
                                level="H1"
                            />
                        </HBox>
                        <!-- Name -->
                        <HBox>
                            <Label
                                text="{i18n>Street}"
                                showColon="true"
                                width="70px"
                            />
                            <Text
                                width="340px"
                                id="streetText"
                                text="{oAddressDetailsModel>/street}"
                            />
                        </HBox>
                        <!-- Email -->
                        <HBox>
                            <Label
                                text="{i18n>City}"
                                showColon="true"
                                width="70px"
                            />
                            <Text
                                width="340px"
                                id="cityText"
                                text="{oAddressDetailsModel>/city}"
                            />
                        </HBox>
                        <!-- Phone -->
                        <HBox>
                            <Label
                                text="{i18n>Pincode}"
                                showColon="true"
                                width="70px"
                            />
                            <Text
                                width="340px"
                                id="pincodeText"
                                text="{oAddressDetailsModel>/pincode}"
                            />
                        </HBox>
                    </items>
                </VBox>
            </VBox>
        </content>
        <footer>
            <Bar>
                <contentLeft>
                    <Button
                        text="BACK"
                        type="Ghost"
                        icon="sap-icon://arrow-left"
                        press="onBACKButtonPress"
                    />
                </contentLeft>
            </Bar>
        </footer>
    </Page>
</mvc:View>
